{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/tradingbro-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=./data/tradingbro.db"
  },
  "Collectors": {
    "PollIntervalSeconds": 30,
    "InitialBackfillHours": 6,
    "Binance": { "Enabled": true },
    "Bybit":   { "Enabled": true },
    "Upbit":   { "Enabled": true },
    "Bithumb": { "Enabled": true }
  },
  "Telegram": {
    "Enabled": false,
    "BotToken": "",
    "ChatIds": []
  },
  "Strategies": {
    "Enabled": false,
    "PositionManagementIntervalSeconds": 60,
    "MaxAnnouncementAgeMinutes": 10,
    "SpotListingShort": {
      "Enabled": false,
      "TriggerExchanges": [ "Binance", "Upbit", "Bithumb" ],
      "PreferredExecutionExchanges": [ "Binance", "Bybit" ],
      "QuotePerTradeUsdt": 100,
      "StopLossPct": 0.20,
      "TakeProfitPct": 0.15,
      "MaxHoldHours": 22,
      "MinFuturesAgeDays": 1,
      "Leverage": 1,
      "MarginMode": "Isolated",
      "ManagementIntervalSeconds": 60
    }
  },
  "Trading": {
    "Mode": "Paper",
    "RequireLiveConfirm": "",
    "MaxOpenPositions": 3,
    "MaxDailyLossUsd": 0,
    "Binance": {
      "ApiKey": "",
      "ApiSecret": "",
      "RestUrl": ""
    },
    "Bybit":   { "ApiKey": "", "ApiSecret": "" }
  }
}
